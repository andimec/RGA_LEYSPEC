  <widget type="label" version="2.0.0"><name>ModeL</name><text>Mode</text><x>40</x><y>295</y><width>110</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Mode</name><pv_name>$(P)MODE</pv_name><x>155</x><y>290</y><width>215</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>SpeedL</name><text>Speed</text><x>40</x><y>330</y><width>110</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Speed</name><pv_name>$(P)SPEED:SET</pv_name><x>155</x><y>325</y><width>215</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>RangeL</name><text>First / Last mass</text><x>40</x><y>365</y><width>110</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>FirstMass</name><pv_name>$(P)MASS:FIRST</pv_name><x>155</x><y>360</y><width>95</width><height>28</height></widget>
  <widget type="textupdate" version="2.0.0"><name>LastMass</name><pv_name>$(P)MASS:LAST</pv_name><x>255</x><y>360</y><width>115</width><height>28</height></widget>

  <widget type="rectangle" version="2.0.0"><name>MeasurementBox</name><x>405</x><y>140</y><width>370</width><height>250</height><line_width>2</line_width></widget>
  <widget type="label" version="2.0.0"><name>MeasurementTitle</name><text>MEASUREMENT</text><x>420</x><y>150</y><width>180</width><height>22</height><font><font family="Liberation Sans" style="BOLD" size="15.0"/></font></widget>
  <widget type="label" version="2.0.0"><name>MeasuringL</name><text>Measuring</text><x>425</x><y>190</y><width>110</width><height>20</height></widget>
  <widget type="led" version="2.0.0"><name>MeasuringLED</name><pv_name>$(P)MEASURING</pv_name><x>550</x><y>185</y><width>24</width><height>24</height></widget>
  <widget type="label" version="2.0.0"><name>PressureL</name><text>Total pressure</text><x>425</x><y>230</y><width>110</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Pressure</name><pv_name>$(P)PRESSURE:TOTAL</pv_name><x>550</x><y>225</y><width>190</width><height>32</height><horizontal_alignment>1</horizontal_alignment></widget>
  <widget type="label" version="2.0.0"><name>PressureStatusL</name><text>Pressure SP status</text><x>425</x><y>270</y><width>125</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>PressureStatus</name><pv_name>$(P)PRESSURE:SETPOINT:STATUS</pv_name><x>550</x><y>265</y><width>190</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>Analog1L</name><text>Analog input 1</text><x>425</x><y>310</y><width>110</width><height>20</height></widget>
