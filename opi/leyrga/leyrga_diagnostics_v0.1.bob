<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>LEYSPEC RGA Diagnostics V0.1</name>
  <width>1200</width>
  <height>850</height>

  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>LEYSPEC RGA - DIAGNOSTICS V0.1</text>
    <x>25</x><y>15</y><width>700</width><height>32</height>
    <font><font family="Liberation Sans" style="BOLD" size="24.0"/></font>
  </widget>

  <widget type="label" version="2.0.0">
    <name>Prefix</name>
    <text>PV prefix: $(P)</text>
    <x>850</x><y>20</y><width>320</width><height>24</height>
    <horizontal_alignment>2</horizontal_alignment>
  </widget>

  <widget type="rectangle" version="2.0.0">
    <name>ConnectionBox</name>
    <x>20</x><y>60</y><width>1160</width><height>65</height>
    <line_width>2</line_width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>ConnectionLabel</name><text>COMMUNICATION</text>
    <x>35</x><y>70</y><width>170</width><height>22</height>
    <font><font family="Liberation Sans" style="BOLD" size="15.0"/></font>
  </widget>
  <widget type="led" version="2.0.0">
    <name>ConnectedLED</name><pv_name>$(P)CONNECTED</pv_name>
    <x>220</x><y>72</y><width>24</width><height>24</height>
  </widget>
  <widget type="label" version="2.0.0"><name>ConnectedText</name><text>Connected</text><x>250</x><y>75</y><width>90</width><height>18</height></widget>
  <widget type="label" version="2.0.0"><name>CommCountLabel</name><text>Transactions</text><x>380</x><y>75</y><width>90</width><height>18</height></widget>
  <widget type="textupdate" version="2.0.0"><name>CommCount</name><pv_name>$(P)COMM:COUNT</pv_name><x>475</x><y>70</y><width>100</width><height>28</height><horizontal_alignment>1</horizontal_alignment></widget>
  <widget type="label" version="2.0.0"><name>CommErrorLabel</name><text>Comm errors</text><x>620</x><y>75</y><width>80</width><height>18</height></widget>
  <widget type="textupdate" version="2.0.0"><name>CommErrors</name><pv_name>$(P)COMM:ERROR</pv_name><x>705</x><y>70</y><width>90</width><height>28</height><horizontal_alignment>1</horizontal_alignment></widget>
  <widget type="label" version="2.0.0"><name>StatusLabel</name><text>Status</text><x>830</x><y>75</y><width>50</width><height>18</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Status</name><pv_name>$(P)STATUS</pv_name><x>885</x><y>70</y><width>270</width><height>28</height></widget>

  <widget type="rectangle" version="2.0.0"><name>InstrumentBox</name><x>20</x><y>140</y><width>370</width><height>250</height><line_width>2</line_width></widget>
  <widget type="label" version="2.0.0"><name>InstrumentTitle</name><text>INSTRUMENT</text><x>35</x><y>150</y><width>180</width><height>22</height><font><font family="Liberation Sans" style="BOLD" size="15.0"/></font></widget>
  <widget type="label" version="2.0.0"><name>ModelL</name><text>Model</text><x>40</x><y>190</y><width>110</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Model</name><pv_name>$(P)MODEL</pv_name><x>155</x><y>185</y><width>215</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>VersionL</name><text>Version</text><x>40</x><y>225</y><width>110</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Version</name><pv_name>$(P)VERSION</pv_name><x>155</x><y>220</y><width>215</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>MassRangeL</name><text>Mass range</text><x>40</x><y>260</y><width>110</width><height>20</height></widget>
