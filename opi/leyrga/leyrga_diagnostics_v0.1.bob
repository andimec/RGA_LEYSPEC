  <widget type="textupdate" version="2.0.0"><name>Analog2</name><pv_name>$(P)ANALOG:INPUT2</pv_name><x>550</x><y>345</y><width>190</width><height>28</height></widget>

  <widget type="rectangle" version="2.0.0"><name>SourceBox</name><x>790</x><y>140</y><width>390</width><height>250</height><line_width>2</line_width></widget>
  <widget type="label" version="2.0.0"><name>SourceTitle</name><text>SOURCE / DETECTOR</text><x>805</x><y>150</y><width>220</width><height>22</height><font><font family="Liberation Sans" style="BOLD" size="15.0"/></font></widget>
  <widget type="label" version="2.0.0"><name>FilamentL</name><text>Filament</text><x>810</x><y>195</y><width>120</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Filament</name><pv_name>$(P)FILAMENT</pv_name><x>940</x><y>190</y><width>210</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>DetectorL</name><text>Detector</text><x>810</x><y>235</y><width>120</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>Detector</name><pv_name>$(P)DETECTOR</pv_name><x>940</x><y>230</y><width>210</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>ErrorCodeL</name><text>Instrument error</text><x>810</x><y>275</y><width>120</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>ErrorCode</name><pv_name>$(P)ERROR:CODE</pv_name><x>940</x><y>270</y><width>210</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>RawErrorL</name><text>Raw error</text><x>810</x><y>315</y><width>120</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>RawError</name><pv_name>$(P)ERROR:RAW</pv_name><x>940</x><y>310</y><width>210</width><height>28</height></widget>
  <widget type="label" version="2.0.0"><name>DriverErrorL</name><text>Driver error</text><x>810</x><y>355</y><width>120</width><height>20</height></widget>
  <widget type="textupdate" version="2.0.0"><name>DriverError</name><pv_name>$(P)ERROR</pv_name><x>940</x><y>350</y><width>210</width><height>28</height></widget>

  <widget type="label" version="2.0.0">
    <name>SpectrumTitle</name><text>MASS SPECTRUM</text>
    <x>25</x><y>415</y><width>250</width><height>24</height>
    <font><font family="Liberation Sans" style="BOLD" size="17.0"/></font>
  </widget>

  <widget type="xyplot" version="3.0.0">
    <name>SpectrumPlot</name>
    <x>20</x><y>445</y><width>1160</width><height>350</height>
    <title>MASS SPECTRUM</title>
    <x_axis>
      <title>Mass / m/z</title>
      <auto_scale>true</auto_scale>
      <show_grid>true</show_grid>
    </x_axis>
    <y_axes>
      <axis>
        <title>Partial pressure</title>
        <log_scale>true</log_scale>
        <auto_scale>true</auto_scale>
        <show_grid>true</show_grid>
      </axis>
    </y_axes>
    <traces>
      <trace>
        <name>Spectrum</name>
        <x_pv>$(P)MASS:AXIS</x_pv>
        <y_pv>$(P)SPECTRUM</y_pv>
      </trace>
    </traces>
  </widget>

  <widget type="label" version="2.0.0">
    <name>Footer</name>
    <text>V0.1 diagnostic display. Generic deployment using the P macro.</text>
    <x>25</x><y>810</y><width>600</width><height>20</height>
  </widget>
</display>
